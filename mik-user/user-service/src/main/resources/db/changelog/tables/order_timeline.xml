<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="create_order_timeline_table" author="mik">
        <createTable tableName="order_timeline">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="time" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="desc" type="text"/>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="order_timeline" indexName="idx_order_id">
            <column name="order_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="add_photos_to_order_timeline" author="mik">
        <addColumn tableName="order_timeline">
            <column name="photos" type="text" remarks="照片URL列表，JSON格式存储"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
